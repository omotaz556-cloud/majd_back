NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/majd_games

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Tax config (قابل للضبط حسب المعالجة المحاسبية)
DEFAULT_VAT_RATE=15
DEFAULT_TAX_MODE=inclusive

# ====== المزوّدين (Providers) ======
# وضع التطوير الحالي: mock/local للكل، يعني بدون أي حساب Moyasar أو شبكة
# إعلانات أو تكامل حساب منصة، وبدون أي اتصال بالإنترنت. لما بيانات العميل
# توصل، غيّر القيم دي:
#   PAYMENT_PROVIDER=moyasar
#   ADS_PROVIDER=google-ad-manager
#   ACCOUNT_PROVIDER=majd_platform
# وحط مفاتيح Moyasar ومعرّفات Google Ad Manager تحت.
PAYMENT_PROVIDER=mock
ADS_PROVIDER=mock

# 'local': تسجيل دخول/حساب محلي بإيميل وباسورد (الوضع الحالي، الافتراضي).
# 'majd_platform': اللاعب بيدخل بحسابه الموجود في منصة مجد مباشرة - من غير
# تسجيل جديد. التنفيذ الفعلي لسه محتاج يتحدد (راجع
# src/modules/auth/providers/majdPlatform.provider.js)، ومحتمل يحتاج متغيرات
# بيئة إضافية زي MAJD_PLATFORM_API_URL / MAJD_PLATFORM_API_KEY وقتها.
ACCOUNT_PROVIDER=local

# رابط الرجوع بعد الدفع (المفروض يكون رابط صفحة الفرونت إند، مثلاً /payment/callback)
# لازم يكون رابط حقيقي شغال في الإنتاج لو PAYMENT_PROVIDER=moyasar
DEPOSIT_CALLBACK_URL=http://localhost:5173/payment/callback
DEPOSIT_CURRENCY=SAR

# ====== استعادة كلمة المرور (Forgot/Reset Password) ======
# 'mock' (افتراضي): مفيش إيميل حقيقي بيتبعت - رابط الاستعادة بيتطبع في
# console السيرفر بس، مفيد للتطوير والاختبار المحلي بدون أي حساب Resend.
# 'resend': إيميل حقيقي فعلي عن طريق Resend API - محتاج تخلّص إعداد الـ DNS
# بتاع الدومين في Resend Dashboard > Domains الأول (لحد ما يبقى الدومين
# "Verified")، وبعدين تحط RESEND_API_KEY و RESEND_FROM_EMAIL تحت وتغيّر
# القيمة هنا لـ resend - من غير أي تعديل كود.
EMAIL_PROVIDER=mock

# لازم يكون رابط الفرونت إند الحقيقي (بدون / في الآخر) - بيُستخدم لبناء رابط
# استعادة كلمة المرور اللي بيتبعت في الإيميل، مثلاً:
# FRONTEND_URL=https://majd-games.com
FRONTEND_URL=http://localhost:5173

# ====== لو EMAIL_PROVIDER=resend (مش محتاجينهم في وضع mock) ======
# من Resend Dashboard > API Keys
# RESEND_API_KEY=re_your_api_key
# لازم يكون على دومين تم التحقق منه (Verified) في Resend Dashboard > Domains -
# مثال: "مجد <noreply@majd-games.com>" أو إيميل بسيط "noreply@majd-games.com"
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ====== لو PAYMENT_PROVIDER=moyasar (مش محتاجينهم في وضع mock) ======
# secret key: من Dashboard > Settings > API Keys (يبدأ بـ sk_test_ أو sk_live_)
# MOYASAR_SECRET_KEY=sk_test_your_secret_key
# publishable key: نفس الصفحة، ده اللي بيتبعت للفرونت إند (آمن يتشحن في المتصفح)
# MOYASAR_PUBLISHABLE_KEY=pk_test_your_publishable_key
# لازم يتظبط بنفس القيمة اللي هتحطها في Dashboard > Settings > Webhooks
# MOYASAR_WEBHOOK_SECRET=change_this_to_a_long_random_secret

# ====== نظام الإعلانات (Google Ad Manager - Web / HTML5 Games) ======
# المنصة دي ويب بالكامل - مفيش AdMob SDK ولا أي تكامل موبايل هنا خالص.
# لما العميل يخلّص حساب Google Ad Manager بتاعه، غيّر ADS_PROVIDER فوق
# لـ google-ad-manager، واملأ القيم دي بالمعرّفات الحقيقية من حسابه، وردپلوي.
# مفيش أي تعديل كود مطلوب في أي مرحلة.
ADS_ENABLED=true
ADS_DEBUG=true
ADS_TEST_MODE=true

# من Google Ad Manager Dashboard > Admin > Global settings
GOOGLE_AD_MANAGER_NETWORK_CODE=TEST_NETWORK
GOOGLE_PUBLISHER_ID=pub-test
GOOGLE_APP_ID=test-app

# معرّفات وحدات الإعلان (Ad Units) - كل وحدة بتتعمل من Ad Manager Dashboard
GOOGLE_BANNER_AD_UNIT=test-banner
GOOGLE_INTERSTITIAL_AD_UNIT=test-interstitial
GOOGLE_REWARDED_AD_UNIT=test-rewarded

# توكن احتياطي - لو Google أضافت مستقبلاً آلية تحقق مشابهة لـ SSV الخاص
# بالموبايل لإعلانات الويب المكافئة. حالياً التحقق بيتم بالكامل عن طريق
# جلسات موقّعة (HMAC) من سيرفرنا نفسه - راجع REWARD_SESSION_SECRET تحت.
GOOGLE_REWARDED_SERVER_TOKEN=test-token

# مبلغ المكافأة (بوحدة المحفظة/الكوين) لكل إعلان مكافئ يتشاف بنجاح -
# ساري في وضعي mock و google-ad-manager على حد سواء
MOCK_AD_REWARD_AMOUNT=5

# مدة صلاحية جلسة المكافأة بالثواني قبل ما تنتهي (افتراضي 5 دقايق)
REWARD_SESSION_TTL_SECONDS=300

# سر توقيع جلسات المكافأة (HMAC) - غيّره لقيمة عشوائية طويلة في الإنتاج.
# لو متسيبش، بيرجع تلقائياً لنفس قيمة JWT_SECRET
REWARD_SESSION_SECRET=change_this_to_a_long_random_secret

# سر مشترك (shared secret) لحماية POST /api/ads/webhook - أي طلب لازم يبعت
# نفس القيمة دي في هيدر X-Webhook-Secret. إجباري في الإنتاج (NODE_ENV=production).
ADS_WEBHOOK_SECRET=change_this_to_a_long_random_secret
